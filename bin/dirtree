#!/usr/bin/env bash
# Thin wrapper that exec's the Zig-built dirtree binary.
# The legacy bash implementation is preserved as bin/dirtree.bash.
DIRTREE_ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
ZIG_BIN="$DIRTREE_ROOT/zig-out/bin/dirtree"

if [[ ! -x "$ZIG_BIN" ]]; then
	echo "Error: dirtree binary not found at $ZIG_BIN" >&2
	echo "Run './build' first to compile the Zig binary." >&2
	exit 1
fi

exec "$ZIG_BIN" "$@"
