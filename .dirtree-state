# Dirtree: Stateful directory trees in the CLI for humans and LLMs. https://github.com/pmarreck/dirtree
ver=1.2
depth=2
hyperlink=false

close=[
	.git
	.jj
	src/i18n
]

hide=[
	.claude
	.dirtree-state
	.git
]

annotate=[
	MISTAKES.md = Errors-made log for future sessions (jj rebase ancestor-drop near-miss)
	PLAN.md = Audit remediation checklist + Done log
	PROJECT_OVERVIEW.md = Project goals, architecture map, terminology
	RULES.md = Hard invariants that must never be violated without strong justification
	docs/example.html = Committed styled HTML example (src/ tree; regenerate: dirtree --html docs/example.html --no-hyperlinks src)
	scripts/gen_html_font_subset.sh = Regenerate the HTML icon-font subset from icons.zig codepoints (hb-subset+woff2 via nix); writes src/assets/*.woff2
	src/ansi.zig = ANSI color constants, OSC8 hyperlinks, percent-encoding, stats message
	src/assets/NOTICE-nerd-font.md = MIT license/attribution for the embedded Nerd Font subset
	src/assets/symbols-nerd-font-subset.woff2 = Embedded 62-glyph MIT Symbols Nerd Font subset (~12.7KB) for HTML output icons
	src/dir_scan.zig = Directory listing, stat, sorting (alpha/modified, asc/desc)
	src/html_font.zig = Embedded MIT Symbols Nerd Font subset (@embedFile woff2 + comptime base64) as @font-face data-URI for HTML icons
	src/html_render.zig = Pure HTML output adapter: HtmlNode tree -> self-contained dark-theme HTML (<details> tree, escaping, classes, links, notes, icons); no I/O
	src/i18n = 50 locale string tables (one .zig per locale) + registry/schema/aliases infra
	src/i18n/cli_aliases.zig = Per-locale CLI/arg aliases (localized flag names, own-language only)
	src/i18n/mod.zig = Locale registry: code()=@tagName, parseLocaleCode, available_codes, cli_alias_map
	src/i18n/strings.zig = Strings schema (all user-facing fields) + CliArg enum; completeness enforced
	src/icons.zig = Nerd Font icon map: extension + filename StaticStringMaps, getFileIcon precedence
	src/main.zig = CLI parsing/orchestration; real-TTY presentation persistence, shared-view persistence, provenance notes; HTML output routing
	src/path_eval.zig = open/close/show/hide evaluation and same-type precedence rules
	src/pcre2.zig = PCRE2 wrapper: compile/find/matches/partialMatch, DFA mode, UTF-8+UCP, OOM-propagating
	src/regex.zig = Glob to regex conversion, escape-aware isGlobPattern, pattern-kind detection
	src/runtime.zig = Zig 0.16 I/O threading bridge via process-global wrapper; io()/env() accessors
	src/scm.zig = Git/jj SCM-changed priority paths (jj overrides Git); falls back git on jj failure
	src/state.zig = .dirtree-state parse/serialize, inheritance chain, parseBool truthy parser
	src/threshold_writer.zig = Streaming Writer that buffers to a line threshold then warns+flushes+streams (single-walk large-output warning)
	src/tree_render.zig = Pure terminal/HTML tree rendering; resolves CLI/state/TTY decoration precedence and color overrides
	src/update_check.zig = Background newer-release check + cache; Windows cachePath fallbacks
]
