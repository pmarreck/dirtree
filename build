#!/usr/bin/env bash
# Build dirtree
set -euo pipefail

MIN_ZIG_VERSION="0.15.0"

# Compare semver: returns 0 if $1 >= $2
version_gte() {
	printf '%s\n%s\n' "$2" "$1" | sort -V | head -n1 | grep -qx "$2"
}

if command -v nix &>/dev/null; then
	echo "Using nix develop to build..."
	exec nix develop -c zig build "$@"
elif command -v zig &>/dev/null; then
	zig_ver=$(zig version)
	if version_gte "$zig_ver" "$MIN_ZIG_VERSION"; then
		echo "Using zig $zig_ver to build..."
		exec zig build "$@"
	else
		echo "Error: zig $zig_ver found but >= $MIN_ZIG_VERSION is required" >&2
		echo "Install a newer zig or install nix (https://nixos.org/download)" >&2
		exit 1
	fi
else
	echo "Error: neither nix nor zig found on PATH" >&2
	echo "Install one of:" >&2
	echo "  - nix: https://nixos.org/download" >&2
	echo "  - zig >= $MIN_ZIG_VERSION: https://ziglang.org/download/" >&2
	exit 1
fi
