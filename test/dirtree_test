# Test implementations

test_dirtree_root_points_to_repo_root() {
	if [[ ! -x "$DIRTREE_BIN" ]]; then
		echo "dirtree binary not found at $DIRTREE_BIN" >&2
		return 1
	fi
	# Verify the binary runs and produces output
	local out
	out=$("$DIRTREE_BIN" --simple --no-icons "$DIRTREE_ROOT" 2>/dev/null | head -1)
	if [[ -z "$out" ]]; then
		echo "dirtree binary produced no output" >&2
		return 1
	fi
}

test_encode_printable_reads_from_stdin() {
	local actual expected
	expected=$(printf 'abc\0def' | "$PRINTABLE_BINARY_BIN")
	actual=''
	if ! encode_printable actual < <(printf 'abc\0def'); then
		echo "encode_printable failed when reading stdin" >&2
		return 1
	fi
	if [[ "$actual" != "$expected" ]]; then
		echo "encode_printable stdin output mismatch" >&2
		echo "Expected: $expected" >&2
		echo "Actual:   $actual" >&2
		return 1
	fi
}

test_capture_command_printable_handles_nuls() {
	local stdout_pb="" stderr_pb="" rc=0 expected_stdout_pb expected_stderr_pb=""
	expected_stdout_pb=$(printf 'a\0b' | "$PRINTABLE_BINARY_BIN")
	if ! capture_command_printable stdout_pb stderr_pb rc printf '%b' 'a\0b'; then
		echo "capture_command_printable failed to run command" >&2
		return 1
	fi
	if [[ "$rc" -ne 0 ]]; then
		echo "expected rc=0, got rc=$rc" >&2
		return 1
	fi
	if [[ "$stdout_pb" != "$expected_stdout_pb" ]]; then
		echo "stdout mismatch after printable capture" >&2
		echo "Expected (printable): $expected_stdout_pb" >&2
		echo "Actual   (printable): $stdout_pb" >&2
		return 1
	fi
	if [[ "$stderr_pb" != "$expected_stderr_pb" ]]; then
		echo "expected empty stderr, got printable: $stderr_pb" >&2
		return 1
	fi
}

test_capture_dirtree_printable_runs_help() {
	local stdout_pb="" stderr_pb="" rc=0 decoded
	if ! capture_dirtree_printable stdout_pb stderr_pb rc --help; then
		echo "capture_dirtree_printable failed to run dirtree" >&2
		return 1
	fi
	if [[ "$rc" -ne 0 ]]; then
		echo "expected rc=0 from dirtree --help, got $rc" >&2
		return 1
	fi
	if [[ -n "$stderr_pb" ]]; then
		echo "expected empty stderr from dirtree --help" >&2
		return 1
	fi
	decode_printable decoded "$stdout_pb"
	if [[ "$decoded" != *"Usage: dirtree"* ]]; then
		echo "dirtree --help output missing Usage line" >&2
		return 1
	fi
}

test_fixture_helper_resets_state_between_uses() {
	if ! command -v fixture_simple_tree >/dev/null 2>&1; then
		echo "fixture_simple_tree helper is missing" >&2
		return 1
	fi
	local path1 path2
	path1=$(fixture_simple_tree)
	printf 'ver=1.2\ndefault=closed\n' >"$path1/.dirtree-state"
	path2=$(fixture_simple_tree)
	if [[ "$path1" != "$path2" ]]; then
		echo "fixture helper returned different paths; expected reuse" >&2
		return 1
	fi
	if [[ -e "$path2/.dirtree-state" ]]; then
		echo "fixture helper did not clear existing .dirtree-state" >&2
		return 1
	fi
}

test_fixture_decorated_single_file_clears_state() {
	if command -v fixture_decorated_single_file >/dev/null 2>&1; then :; else
		echo "fixture_decorated_single_file helper is missing" >&2
		return 1
	fi
	local path1 path2
	path1=$(fixture_decorated_single_file)
	printf 'ver=1.2\ndefault=opened\n' >"$path1/.dirtree-state"
	path2=$(fixture_decorated_single_file)
	if [[ "$path1" != "$path2" ]]; then
		echo "decor fixture returned different paths; expected reuse" >&2
		return 1
	fi
	if [[ ! -e "$path2/file.txt" ]]; then
		echo "decor fixture missing file.txt" >&2
		return 1
	fi
	if [[ -e "$path2/.dirtree-state" ]]; then
		echo "decor fixture did not clear existing .dirtree-state" >&2
		return 1
	fi
}

test_fixture_hide_show_clears_state() {
	if command -v fixture_hide_show >/dev/null 2>&1; then :; else
