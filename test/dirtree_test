	cnf_env=$(new_tmpfile)
	cat >"$cnf_env" <<'EOF'
command_not_found_handle() {
	return 127
}
EOF
	if run_and_capture "$stdout_file" "$stderr_file" env PATH="$limited_path" BASH_ENV="$cnf_env" "$DIRTREE_BIN" "$target"; then
		echo "Expected eza availability failure" >&2
		return 1
	fi
	if [[ -s "$stdout_file" ]]; then
		echo "Expected empty stdout for eza failure" >&2
		cat "$stdout_file" >&2
		return 1
	fi
	local actual_pb expected_plain expected_pb
	encode_file_printable actual_pb "$stderr_file"
	expected_plain=$'Error: eza is not installed. Please install eza first.\n'
	encode_printable expected_pb "$expected_plain"
	compare_printable "eza availability" "$actual_pb" "$expected_pb"
}

