else
	if [[ -n "$PRINTABLE_BACKING_BIN" ]]; then
		PRINTABLE_BACKING_BIN="$(dirname "$PRINTABLE_BINARY_BIN")/printable_binary_ape.com"
	fi
	print_printable_banner
fi

export BASH_BIN=${BASH_BIN:-$(command -v bash || true)}
if [[ -z "$BASH_BIN" ]]; then
	echo "bash binary not found" >&2
