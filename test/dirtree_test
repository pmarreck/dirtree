	run_test "--only nonexistent collapses all" \
		test_only_nonexistent_collapses_all
}

run_all_tests

if [[ $fail_count -ne 0 ]]; then
	echo "$fail_count of $test_count tests failed" >&2
else
	echo "All $test_count tests passed"
fi

exit $fail_count
