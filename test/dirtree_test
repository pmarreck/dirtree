init_git_repo() {
	local dir="$1"
	(
		cd "$dir" && \
		git init -q >/dev/null && \
		git config user.name "dirtree-test" && \
		git config user.email "dirtree@example.com"
	)
}

run_quiet() {
	"$@" >/dev/null 2>&1
}

encode_printable() {
	local __var="$1"
	shift
	local encoded
	if [[ $# -gt 0 ]]; then
		encoded=$(printf '%s' "$1" | "$PRINTABLE_BINARY_BIN")
	else
		encoded=$("$PRINTABLE_BINARY_BIN")
	fi
	printf -v "$__var" '%s' "$encoded"
}

encode_file_printable() {
	local __var="$1"
	local file="$2"
	local encoded
	encoded=$("$PRINTABLE_BINARY_BIN" <"$file")
	printf -v "$__var" '%s' "$encoded"
}

decode_printable() {
	local __var="$1"
	local data="$2"
	# memoize by printable binary path to avoid repeated subprocesses
	if [[ -z ${DECODE_CACHE_BIN:-} || "$DECODE_CACHE_BIN" != "$PRINTABLE_BINARY_BIN" ]]; then
		unset DECODE_CACHE
		declare -gA DECODE_CACHE=()
		DECODE_CACHE_BIN="$PRINTABLE_BINARY_BIN"
	fi
	local decoded_value
	if [[ -n ${DECODE_CACHE[$data]+yes} ]]; then
		decoded_value=${DECODE_CACHE[$data]}
	else
		decoded_value=$(printf '%s' "$data" | "$PRINTABLE_BINARY_BIN" -d)
		DECODE_CACHE[$data]="$decoded_value"
	fi
	printf -v "$__var" '%s' "$decoded_value"
}

normalize_icons_plain() {
	local __var="$1" data="$2"
	local normalized="$data"
	# Map various directory icon glyphs (different eza versions) to a single canonical folder icon
	local -a variants=("󱞞" "󱞝" "󰉋" "" "" "" "" "󰉖" $'\U000F08DE')
	for icon in "${variants[@]}"; do
		normalized="${normalized//${icon}/}"
	done
	# Collapse other private-use glyphs (icon sets) to the same canonical icon for portability
	normalized=$(printf '%s' "$normalized" | perl -CS -pe 's/[\x{E000}-\x{F8FF}\x{F0000}-\x{FFFFD}\x{100000}-\x{10FFFD}]//g')
	printf -v "$__var" '%s' "$normalized"
}

print_printable_to_stderr() {
	local data="$1"
	[[ -z "$data" ]] && return
	printf '%s' "$data" | "$PRINTABLE_BINARY_BIN" -d >&2
}

capture_command_printable() {
	local __stdout_var="$1"
	local __stderr_var="$2"
	local __rc_var="$3"
	shift 3
	local out="" err=""
	rc=0
	if ! capture -p "$@"; then
		return 1
	fi
	printf -v "$__stdout_var" '%s' "$out"
	printf -v "$__stderr_var" '%s' "$err"
	printf -v "$__rc_var" '%s' "$rc"
	return 0
}

capture_dirtree_printable() {
	local __stdout_var="$1"
	local __stderr_var="$2"
	local __rc_var="$3"
	shift 3
	capture_command_printable "$__stdout_var" "$__stderr_var" "$__rc_var" "$DIRTREE_BIN" "$@"
}

capture_dirtree_test_printable() {
	local __stdout_var="$1"
	local __stderr_var="$2"
	local __rc_var="$3"
	shift 3
	capture_command_printable "$__stdout_var" "$__stderr_var" "$__rc_var" "$@" "$DIRTREE_BIN" --test
}

capture_dirtree_printable_outputs() {
	local __stdout_name="$1" __stderr_name="$2" __rc_name="$3"
	shift 3
	if ! capture_printable_outputs "$__stdout_name" "$__stderr_name" "$__rc_name" "$DIRTREE_BIN" "$@"; then
		return 1
	fi
	return 0
}

capture_printable_outputs() {
	local -n __stdout_ref="$1"
	local -n __stderr_ref="$2"
	local -n __rc_ref="$3"
	shift 3
	local out err rc
	if ! capture -p "$@"; then
		return 1
	fi
	__stdout_ref="$out"
	__stderr_ref="$err"
	__rc_ref="$rc"
	return 0
}

build_decorated_root_header_plain() {
	local __var="$1" target="$2" icons="${3:-true}" icon_char="${4:-}"
	local base parent
	base=$(basename "$target")
	parent=$(dirname "$target")
	if [[ "$icons" == true ]]; then
		printf -v "$__var" $'\e[34m%s \e[36m%s/\e[0m\e]8;;file://%s\e\\\e[1;34m%s\e[0m/\e]8;;\e\\\n' \
			"$icon_char" "$parent" "$target" "$base"
	else
		printf -v "$__var" $'\e[36m%s/\e[0m\e]8;;file://%s\e\\\e[1;34m%s\e[0m/\e]8;;\e\\\n' \
			"$parent" "$target" "$base"
	fi
}

build_decorated_with_hyperlinks_plain() {
	local __var="$1" target="$2" filename="$3" icons="${4:-true}"
	local prefix
	if [[ "$icons" == true ]]; then
		prefix=$'└──  '
	else
		prefix=$'└── '
	fi
	printf -v "$__var" $'%s\e]8;;file://%s/%s\e\\%s\e]8;;\e\\\n' \
		"$prefix" "$target" "$filename" "$filename"
}

build_decorated_without_hyperlinks_plain() {
	local __var="$1" target="$2" filename="$3"
	local base parent
	base=$(basename "$target")
	parent=$(dirname "$target")
	printf -v "$__var" $'\e[34m \e[36m%s/\e[0m\e[1;34m%s\e[0m/\n└──  %s\n' \
		"$parent" "$base" "$filename"
}

build_decorated_dir_entry_plain() {
	local __var="$1" target="$2" relative="$3" connector="$4" icons="${5:-true}" icon_char="${6:-}" suffix="${7:-/}"
	if [[ "$icons" == true ]]; then
		printf -v "$__var" $'%s\e[34m%s \e[0m\e]8;;file://%s/%s\e\\\e[1;34m%s\e[0m%s\e]8;;\e\\\n' \
			"$connector" "$icon_char" "$target" "$relative" "$relative" "$suffix"
	else
		printf -v "$__var" $'%s\e]8;;file://%s/%s\e\\%s\e]8;;\e\\%s\n' \
			"$connector" "$target" "$relative" "$relative" "$suffix"
	fi
}

build_decorated_file_entry_plain() {
	local __var="$1" target="$2" filename="$3" connector="$4" icons="${5:-true}" icon_char="${6:-}"
	local prefix="$connector"
	if [[ -z "$prefix" ]]; then
		prefix=$'└── '
	fi
	if [[ "$icons" == true ]]; then
		prefix+="$icon_char "
	fi
	printf -v "$__var" $'%s\e]8;;file://%s/%s\e\\%s\e]8;;\e\\\n' \
		"$prefix" "$target" "$filename" "$filename"
}

compare_printable() {
	local name="$1"
	local actual="$2"
	local expected="$3"
	if [[ "$actual" == "$expected" ]]; then
		return 0
	fi
	local actual_plain expected_plain
	decode_printable actual_plain "$actual"
	decode_printable expected_plain "$expected"
	normalize_icons_plain actual_plain "$actual_plain"
	normalize_icons_plain expected_plain "$expected_plain"
	if [[ "$actual_plain" == "$expected_plain" ]]; then
		return 0
	fi
	echo "  Expected ($name):" >&2
	echo "${expected}" >&2
	echo "  Actual:" >&2
	echo "${actual}" >&2
	return 1
}

compare_printable_encoded() {
	local name="$1"
	local actual="$2"
	local expected="$3"
	if [[ "$actual" == "$expected" ]]; then
		return 0
	fi
	echo "  Expected ($name):" >&2
	echo "${expected}" >&2
	echo "  Actual:" >&2
	echo "${actual}" >&2
	return 1
}

load_printable_cache() {
	if [[ "$PRINTABLE_CACHE_LOADED" == true ]]; then
		return 0
	fi
	if [[ -f "$PRINTABLE_CACHE_FILE" ]]; then
		while IFS= read -r line || [[ -n "$line" ]]; do
			[[ -z "$line" || "$line" == \#* ]] && continue
			local key=${line%%=*}
			local val=${line#*=}
			PRINTABLE_CACHE["$key"]="$val"
		done < "$PRINTABLE_CACHE_FILE"
	fi
	PRINTABLE_CACHE_LOADED=true
}

save_printable_cache_entry() {
	local key="$1" val="$2"
	# ensure dir exists
	mkdir -p "$(dirname "$PRINTABLE_CACHE_FILE")"
	printf '%s=%s\n' "$key" "$val" >>"$PRINTABLE_CACHE_FILE"
}

encode_printable_cached() {
	local __var="$1" key="$2" data="$3"
	load_printable_cache
	if [[ -n ${PRINTABLE_CACHE[$key]+yes} ]]; then
		printf -v "$__var" '%s' "${PRINTABLE_CACHE[$key]}"
		return 0
	fi
	local encoded
	encoded=$(printf '%s' "$data" | "$PRINTABLE_BINARY_BIN")
	PRINTABLE_CACHE["$key"]="$encoded"
	save_printable_cache_entry "$key" "$encoded"
	printf -v "$__var" '%s' "$encoded"
}

test_count=0
