	workspace=$(new_tmpdir); target="$workspace/ctrl"; mkdir -p "$target/sub"
	"$DIRTREE_BIN" --no-color "$target" >/dev/null 2>&1
	if [ ! -f "$target/.dirtree-state" ]; then echo "--no-color alone should persist (control)" >&2; return 1; fi
