	actual_pb="$stdout_pb"
	printf -v expected_plain ' %s/\n├──  root.txt\n└──  sub/\n' "$target"
	encode_printable expected_pb "$expected_plain"
	compare_printable "depth limiting" "$actual_pb" "$expected_pb"
