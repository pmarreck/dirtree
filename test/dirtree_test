set -uo pipefail

export WASM_RUNNER=${WASM_RUNNER:-"wazero"}

export USE_WASM=${USE_WASM:-true}
PRINTABLE_BACKING_BIN=""

print_printable_banner() {
	local backing="${PRINTABLE_BACKING_BIN:-}"
	local wrapper="${PRINTABLE_BINARY_BIN:-}"
	[[ -z "$backing" ]] && return 0
	printf 'Using %s as printable_binary executable via wrapper %s\n' "$backing" "$wrapper" >&2
}

export DIRTREE_ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
export TEST_SCRIPT_DIR="$DIRTREE_ROOT/test"
export PB_BIN_ROOT="$DIRTREE_ROOT/bin"

# error out unless a wasm runner exists
if [[ "$USE_WASM" == "false" || "$USE_WASM" == "0" || "$USE_WASM" == "no" || "$USE_WASM" == "off" ]]; then
	PRINTABLE_BACKING_BIN="$PB_BIN_ROOT/printable_binary_ape.com"
	unset WASM_RUNNER WASM_COMMAND
elif [[ ! -x "$(command -v "$WASM_RUNNER")" ]]; then
	echo "$WASM_RUNNER or another suitable wasm runner was not found (set via \$WASM_RUNNER); defaulting to printable_binary_ape.com" >&2
	PRINTABLE_BACKING_BIN="$PB_BIN_ROOT/printable_binary_ape.com"
	unset WASM_RUNNER WASM_COMMAND
else
	echo "Using $WASM_RUNNER as wasm runner for printable_binary" >&2
	export WASM_COMMAND=${WASM_COMMAND:-"$WASM_RUNNER run --env-inherit"}
fi

export DIRTREE_ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
export TEST_SCRIPT_DIR="$DIRTREE_ROOT/test"
export PB_BIN_ROOT="$DIRTREE_ROOT/bin"

export DIRTREE_BIN="${DIRTREE_BIN:-$DIRTREE_ROOT/zig-out/bin/dirtree}"

if [[ ! -x "$DIRTREE_BIN" ]]; then
	echo "dirtree binary not found at $DIRTREE_BIN" >&2
	exit 1
fi

if [[ -z "${PRINTABLE_BINARY_MAP:-}" && -f "$DIRTREE_ROOT/character_map.txt" ]]; then
	export PRINTABLE_BINARY_MAP="$DIRTREE_ROOT/character_map.txt"
fi

SYSTEM_PRINTABLE_BINARY_BIN=${SYSTEM_PRINTABLE_BINARY_BIN:-$(command -v printable_binary || true)}
if [[ -z "${PRINTABLE_BINARY_BIN:-}" ]]; then
	if [[ -x "$PB_BIN_ROOT/printable_binary" ]]; then
		PRINTABLE_BINARY_BIN="$PB_BIN_ROOT/printable_binary"
	else
		PRINTABLE_BINARY_BIN=$(command -v printable_binary || true)
	fi
fi
export PRINTABLE_BINARY_BIN
