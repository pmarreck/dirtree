		return 1
	fi
	if [[ -n "$stderr_pb" ]]; then
		echo "Unexpected stderr for percent-encoded run" >&2
		return 1
	fi
	# Decode actual output and verify key properties:
	# 1. URL contains percent-encoded space and parens for dir name with spaces
	# 2. Display name is single-quoted
	# 3. Closed marker /* is present
	local actual_plain
	decode_printable actual_plain "$stdout_pb"
	# Check for percent-encoded URL (space=20, parens=28/29)
	if [[ "$actual_plain" != *"sys%20%28server%29"* ]]; then
		echo "Missing percent-encoded URL 'sys%20%28server%29' in output" >&2
		echo "Actual:" >&2
		echo "$actual_plain" >&2
