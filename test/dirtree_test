test_purge_orphaned_notes_subcommand() {
	local workspace target out=""
	workspace=$(new_tmpdir)
	target="$workspace/on-purge"
	mkdir -p "$target"
	touch "$target/real.txt"
	(cd "$target" && "$DIRTREE_BIN" annotate ghost.txt "missing note") >/dev/null 2>&1
	(cd "$target" && "$DIRTREE_BIN" annotate real.txt "real note") >/dev/null 2>&1
	out=$(cd "$target" && "$DIRTREE_BIN" purge-orphaned-notes 2>/dev/null)
	if [[ "$out" != *"ghost.txt"* ]]; then
		echo "expected purge to report ghost.txt; got: $out" >&2
		return 1
	fi
	if rg -q 'ghost\.txt' "$target/.dirtree-state"; then
		echo "ghost.txt should have been purged from the state file" >&2
		cat "$target/.dirtree-state" >&2
		return 1
	fi
	if ! rg -q 'real\.txt = real note' "$target/.dirtree-state"; then
		echo "real.txt note should remain in the state file" >&2
		cat "$target/.dirtree-state" >&2
		return 1
	fi
}

test_orphaned_note_warning() {
	local workspace target stdout_pb="" stderr_pb="" rc=0 stderr_plain
	workspace=$(new_tmpdir)
	target="$workspace/orphan-warn"
	mkdir -p "$target"
	touch "$target/keep.txt"
	# Annotate a path that does not exist -> immediately orphaned
	(cd "$target" && "$DIRTREE_BIN" annotate ghost.txt "note for a missing file") >/dev/null 2>&1
	if ! capture_dirtree_printable stdout_pb stderr_pb rc "$target"; then
		echo "capture helper failed for orphan warning" >&2
		return 1
	fi
	decode_printable stderr_plain "$stderr_pb"
	if [[ "$stderr_plain" != *"orphaned-notes"* ]]; then
		echo "expected orphan warning mentioning orphaned-notes; got:" >&2
		printf '%s\n' "$stderr_plain" >&2
		return 1
	fi
}

test_orphaned_note_warning_suppressed() {
	local workspace target stdout_pb="" stderr_pb="" rc=0 stderr_plain
	workspace=$(new_tmpdir)
	target="$workspace/orphan-warn-suppress"
	mkdir -p "$target"
	touch "$target/keep.txt"
	(cd "$target" && "$DIRTREE_BIN" annotate ghost.txt "note for a missing file") >/dev/null 2>&1
	if ! capture_dirtree_printable stdout_pb stderr_pb rc --no-orphan-warning "$target"; then
		echo "capture helper failed for orphan warning suppression" >&2
		return 1
	fi
	decode_printable stderr_plain "$stderr_pb"
	if [[ "$stderr_plain" == *"orphaned-notes"* ]]; then
		echo "orphan warning should be suppressed by --no-orphan-warning; got:" >&2
		printf '%s\n' "$stderr_plain" >&2
		return 1
	fi
}

