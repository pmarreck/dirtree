set -uo pipefail

export WASM_RUNNER=${WASM_RUNNER:-"wazero"}

export USE_WASM=${USE_WASM:-true}
PRINTABLE_BACKING_BIN=""

print_printable_banner() {
	local backing="${PRINTABLE_BACKING_BIN:-}"
	local wrapper="${PRINTABLE_BINARY_BIN:-}"
	[[ -z "$backing" ]] && return 0
	printf 'Using %s as printable_binary executable via wrapper %s\n' "$backing" "$wrapper" >&2
}

export DIRTREE_ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
export TEST_SCRIPT_DIR="$DIRTREE_ROOT/test"
export PB_BIN_ROOT="$DIRTREE_ROOT/bin"

# error out unless a wasm runner exists
if [[ "$USE_WASM" == "false" || "$USE_WASM" == "0" || "$USE_WASM" == "no" || "$USE_WASM" == "off" ]]; then
	PRINTABLE_BACKING_BIN="$PB_BIN_ROOT/printable_binary_ape.com"
	unset WASM_RUNNER WASM_COMMAND
elif [[ ! -x "$(command -v "$WASM_RUNNER")" ]]; then
	echo "$WASM_RUNNER or another suitable wasm runner was not found (set via \$WASM_RUNNER); defaulting to printable_binary_ape.com" >&2
	PRINTABLE_BACKING_BIN="$PB_BIN_ROOT/printable_binary_ape.com"
	unset WASM_RUNNER WASM_COMMAND
else
	echo "Using $WASM_RUNNER as wasm runner for printable_binary" >&2
	export WASM_COMMAND=${WASM_COMMAND:-"$WASM_RUNNER run --env-inherit"}
fi

export DIRTREE_ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
export TEST_SCRIPT_DIR="$DIRTREE_ROOT/test"
export PB_BIN_ROOT="$DIRTREE_ROOT/bin"

export DIRTREE_BIN="$PB_BIN_ROOT/dirtree"

if [[ ! -x "$DIRTREE_BIN" ]]; then
	echo "dirtree binary not found at $DIRTREE_BIN" >&2
	exit 1
fi

export PRINTABLE_BINARY_BIN=${PRINTABLE_BINARY_BIN:-$(command -v printable_binary || true)}
if [[ -z "$PRINTABLE_BINARY_BIN" ]]; then
	echo "printable_binary not found in PATH; please either set PRINTABLE_BINARY_BIN or add $DIRTREE_ROOT/bin to your PATH or install direnv which will then do this for you automatically" >&2
	exit 1
else
	if [[ -n "$PRINTABLE_BACKING_BIN" ]]; then
		PRINTABLE_BACKING_BIN="$(dirname "$PRINTABLE_BINARY_BIN")/printable_binary_ape.com"
	fi
	print_printable_banner
fi

export PRINTABLE_BINARY_MUTE_STATS=${PRINTABLE_BINARY_MUTE_STATS:-true}

# shellcheck disable=SC1091
source "$TEST_SCRIPT_DIR/capture.bash"

export BASH_BIN=${BASH_BIN:-$(command -v bash || true)}
if [[ -z "$BASH_BIN" ]]; then
	echo "bash binary not found" >&2
	exit 1
fi

export PATH="$PB_BIN_ROOT:$PATH"
: "${TMPDIR:=/tmp}"   # default TMPDIR to /tmp if unset/empty
TMPDIR="${TMPDIR%/}"  # drop any trailing slash
export TMPDIR

declare -a TEST_TEMP_PATHS=()

cleanup() {
	for path in "${TEST_TEMP_PATHS[@]}"; do
		if [[ -n "$path" && -e "$path" ]]; then
			rm -rf "$path"
		fi
	done
}
trap cleanup EXIT

new_tmpdir() {
	local dir
	dir=$(mktemp -d "${TMPDIR}/dirtree-test.XXXXXXXX") || return 1
	TEST_TEMP_PATHS+=("$dir")
	printf '%s\n' "$dir"
}

new_tmpfile() {
	local file
	file=$(mktemp "${TMPDIR}/dirtree-test.XXXXXXXX") || return 1
	TEST_TEMP_PATHS+=("$file")
	printf '%s\n' "$file"
}

init_git_repo() {
	local dir="$1"
	(
		cd "$dir" && \
		git init -q >/dev/null && \
		git config user.name "dirtree-test" && \
		git config user.email "dirtree@example.com"
	)
}

run_and_capture() {
	local stdout_file="$1"
	local stderr_file="$2"
	shift 2
	"$@" >"$stdout_file" 2>"$stderr_file"
	return $?
}

run_quiet() {
	"$@" >/dev/null 2>&1
}

encode_printable() {
	local __var="$1"
	shift
	local encoded
	if [[ $# -gt 0 ]]; then
		encoded=$(printf '%s' "$1" | "$PRINTABLE_BINARY_BIN")
	else
		encoded=$("$PRINTABLE_BINARY_BIN")
	fi
	printf -v "$__var" '%s' "$encoded"
}

encode_file_printable() {
	local __var="$1"
	local file="$2"
	local encoded
	encoded=$("$PRINTABLE_BINARY_BIN" <"$file")
	printf -v "$__var" '%s' "$encoded"
}

decode_printable() {
	local __var="$1"
	local data="$2"
	local decoded_value
	decoded_value=$(printf '%s' "$data" | "$PRINTABLE_BINARY_BIN" -d)
	printf -v "$__var" '%s' "$decoded_value"
}

print_printable_to_stderr() {
	local data="$1"
	[[ -z "$data" ]] && return
	printf '%s' "$data" | "$PRINTABLE_BINARY_BIN" -d >&2
}

capture_command_printable() {
	local __stdout_var="$1"
	local __stderr_var="$2"
	local __rc_var="$3"
	shift 3
	local out="" err=""
	rc=0
	if ! capture -p "$@"; then
		return 1
	fi
	printf -v "$__stdout_var" '%s' "$out"
	printf -v "$__stderr_var" '%s' "$err"
	printf -v "$__rc_var" '%s' "$rc"
	return 0
}

capture_dirtree_printable() {
	local __stdout_var="$1"
	local __stderr_var="$2"
	local __rc_var="$3"
	shift 3
	capture_command_printable "$__stdout_var" "$__stderr_var" "$__rc_var" "$DIRTREE_BIN" "$@"
}

capture_printable_outputs() {
	local -n __stdout_ref="$1"
	local -n __stderr_ref="$2"
	local -n __rc_ref="$3"
	shift 3
	local out err rc
	if ! capture -p "$@"; then
		return 1
	fi
	__stdout_ref="$out"
	__stderr_ref="$err"
	__rc_ref="$rc"
	return 0
}

build_decorated_root_header_plain() {
	local __var="$1" target="$2" icons="${3:-true}" icon_char="${4:-}"
	local base parent
	base=$(basename "$target")
	parent=$(dirname "$target")
	if [[ "$icons" == true ]]; then
		printf -v "$__var" $'\e[34m%s \e[36m%s/\e[0m\e]8;;file://%s\e\\\e[1;34m%s\e[0m/\e]8;;\e\\\n' \
			"$icon_char" "$parent" "$target" "$base"
	else
		printf -v "$__var" $'\e[36m%s/\e[0m\e]8;;file://%s\e\\\e[1;34m%s\e[0m/\e]8;;\e\\\n' \
			"$parent" "$target" "$base"
	fi
}

build_decorated_with_hyperlinks_plain() {
	local __var="$1" target="$2" filename="$3" icons="${4:-true}"
	local prefix
	if [[ "$icons" == true ]]; then
		prefix=$'└──  '
	else
		prefix=$'└── '
	fi
	printf -v "$__var" $'%s\e]8;;file://%s/%s\e\\%s\e]8;;\e\\\n' \
		"$prefix" "$target" "$filename" "$filename"
}

build_decorated_without_hyperlinks_plain() {
	local __var="$1" target="$2" filename="$3"
	local base parent
	base=$(basename "$target")
	parent=$(dirname "$target")
	printf -v "$__var" $'\e[34m \e[36m%s/\e[0m\e[1;34m%s\e[0m/\n└──  %s\n' \
		"$parent" "$base" "$filename"
}

build_decorated_dir_entry_plain() {
	local __var="$1" target="$2" relative="$3" connector="$4" icons="${5:-true}" icon_char="${6:-}" suffix="${7:-/}"
	if [[ "$icons" == true ]]; then
		printf -v "$__var" $'%s\e[34m%s \e[0m\e]8;;file://%s/%s\e\\\e[1;34m%s\e[0m%s\e]8;;\e\\\n' \
			"$connector" "$icon_char" "$target" "$relative" "$relative" "$suffix"
	else
		printf -v "$__var" $'%s\e]8;;file://%s/%s\e\\%s\e]8;;\e\\%s\n' \
			"$connector" "$target" "$relative" "$relative" "$suffix"
	fi
}

build_decorated_file_entry_plain() {
	local __var="$1" target="$2" filename="$3" connector="$4" icons="${5:-true}" icon_char="${6:-}"
	local prefix="$connector"
	if [[ -z "$prefix" ]]; then
		prefix=$'└── '
	fi
	if [[ "$icons" == true ]]; then
		prefix+="$icon_char "
	fi
	printf -v "$__var" $'%s\e]8;;file://%s/%s\e\\%s\e]8;;\e\\\n' \
		"$prefix" "$target" "$filename" "$filename"
}

compare_printable() {
	local name="$1"
	local actual="$2"
	local expected="$3"
	if [[ "$actual" == "$expected" ]]; then
		return 0
	fi
	echo "  Expected ($name):" >&2
	echo "${expected}" >&2
	echo "  Actual:" >&2
	echo "${actual}" >&2
	return 1
}

test_count=0
fail_count=0

run_test() {
	local name="$1"
	shift
	((test_count++))
	if "$@"; then
		echo "✓ $name"
	else
		echo "✗ $name" >&2
		((fail_count++))
	fi
}

# Test implementations

test_dirtree_root_points_to_repo_root() {
	local expected actual
	expected='DIRTREE_ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)'
	actual=$(rg -n '^DIRTREE_ROOT=' "$DIRTREE_ROOT/bin/dirtree" | head -n1 | cut -d: -f2-)
	if [[ "$actual" != "$expected" ]]; then
		echo "DIRTREE_ROOT definition mismatch" >&2
		echo "Expected: $expected" >&2
		echo "Actual:   $actual" >&2
		return 1
	fi
}

test_encode_printable_reads_from_stdin() {
	local actual expected
	expected=$(printf 'abc\0def' | "$PRINTABLE_BINARY_BIN")
	actual=''
	if ! encode_printable actual < <(printf 'abc\0def'); then
		echo "encode_printable failed when reading stdin" >&2
		return 1
	fi
	if [[ "$actual" != "$expected" ]]; then
		echo "encode_printable stdin output mismatch" >&2
		echo "Expected: $expected" >&2
		echo "Actual:   $actual" >&2
		return 1
	fi
}

test_capture_command_printable_handles_nuls() {
	local stdout_pb="" stderr_pb="" rc=0 expected_stdout_pb expected_stderr_pb=""
	expected_stdout_pb=$(printf 'a\0b' | "$PRINTABLE_BINARY_BIN")
	if ! capture_command_printable stdout_pb stderr_pb rc printf '%b' 'a\0b'; then
		echo "capture_command_printable failed to run command" >&2
		return 1
	fi
	if [[ "$rc" -ne 0 ]]; then
		echo "expected rc=0, got rc=$rc" >&2
		return 1
	fi
	if [[ "$stdout_pb" != "$expected_stdout_pb" ]]; then
		echo "stdout mismatch after printable capture" >&2
		echo "Expected (printable): $expected_stdout_pb" >&2
		echo "Actual   (printable): $stdout_pb" >&2
		return 1
	fi
	if [[ "$stderr_pb" != "$expected_stderr_pb" ]]; then
		echo "expected empty stderr, got printable: $stderr_pb" >&2
		return 1
	fi
}

test_printable_banner_ape() {
	local stderr_pb="" stdout_pb="" rc=0 expected_pb backing wrapper
	backing="/tmp/ape.bin"
	wrapper="/tmp/wrapper.bin"
	PRINTABLE_BACKING_BIN="$backing"
	PRINTABLE_BINARY_BIN="$wrapper"
	if ! capture_command_printable stdout_pb stderr_pb rc print_printable_banner; then
		echo "capture failed for banner" >&2
		return 1
	fi
	if [[ "$stderr_pb" == "$stdout_pb" ]]; then :; fi # avoid shellcheck unused
	if [[ "$rc" -ne 0 ]]; then
		echo "expected rc=0 for banner" >&2
		return 1
	fi
	printf -v expected_pb 'Using %s as printable_binary executable via wrapper %s\n' "$backing" "$wrapper"
	encode_printable expected_pb "$expected_pb"
	compare_printable "printable banner ape" "$stderr_pb" "$expected_pb"
}

test_capture_dirtree_printable_runs_help() {
	local stdout_pb="" stderr_pb="" rc=0 decoded
	if ! capture_dirtree_printable stdout_pb stderr_pb rc --help; then
		echo "capture_dirtree_printable failed to run dirtree" >&2
		return 1
	fi
	if [[ "$rc" -ne 0 ]]; then
		echo "expected rc=0 from dirtree --help, got $rc" >&2
		return 1
	fi
	if [[ -n "$stderr_pb" ]]; then
		echo "expected empty stderr from dirtree --help" >&2
		return 1
	fi
	decode_printable decoded "$stdout_pb"
	if [[ "$decoded" != *"Usage: dirtree"* ]]; then
		echo "dirtree --help output missing Usage line" >&2
		return 1
	fi
}

test_dirtree_test_runs_from_any_directory() {
	local workspace stub marker stdout_file stderr_file status
	workspace=$(new_tmpdir)
	marker="$workspace/dirtree-test-marker"
	stub="$workspace/fake_dirtree_test"
	cat >"$stub" <<'EOF'
#!/usr/bin/env bash
if [[ -n "$DIRTREE_TEST_MARKER" ]]; then
	printf 'invoked\n' >>"$DIRTREE_TEST_MARKER"
fi
exit 7
EOF
	chmod +x "$stub"
	stdout_file=$(new_tmpfile)
	stderr_file=$(new_tmpfile)
	(
		cd "$workspace" && \
		run_and_capture "$stdout_file" "$stderr_file" \
			env DIRTREE_TEST_MARKER="$marker" DIRTREE_TEST_BIN="$stub" \
			"$DIRTREE_BIN" --test
	)
	status=$?
	if [[ $status -ne 7 ]]; then
		echo "dirtree --test did not propagate stub exit code" >&2
		echo "stdout:" >&2
		cat "$stdout_file" >&2
		echo "stderr:" >&2
		cat "$stderr_file" >&2
		return 1
	fi
	if [[ ! -s "$marker" ]]; then
		echo "stub marker not created; dirtree --test likely ran wrong path" >&2
		return 1
	fi
}

test_basic_listing_prints_absolute_root_header() {
	local workspace
	workspace=$(new_tmpdir)
	local target="$workspace/basic-root"
	mkdir -p "$target"
	local stdout_pb="" stderr_pb="" rc=0
	if ! capture_printable_outputs stdout_pb stderr_pb rc "$DIRTREE_BIN" "$target"; then
		echo "capture helper failed for basic listing" >&2
		return 1
	fi
	if [[ $rc -ne 0 ]]; then
		echo "dirtree exited non-zero for $target" >&2
		print_printable_to_stderr "$stderr_pb"
		return 1
	fi
	if [[ -n "$stderr_pb" ]]; then
		echo "Unexpected stderr for basic listing" >&2
		print_printable_to_stderr "$stderr_pb"
		return 1
	fi
	local actual_pb expected_plain expected_pb
	actual_pb="$stdout_pb"
	printf -v expected_plain ' %s/\n' "$target"
	encode_printable expected_pb "$expected_plain"
	compare_printable "basic listing prints absolute root header" "$actual_pb" "$expected_pb"
}

