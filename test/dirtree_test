	out=$("$DIRTREE_BIN" --decorated --no-color "$target" 2>/dev/null)
	local line
	line=$(printf '%s\n' "$out" | grep -a "# linknote")
	if [[ -z "$line" ]]; then echo "note missing from decorated output" >&2; return 1; fi
	after="${line#*# linknote}"
	# The closing OSC8 must come AFTER the note => the link wraps the note.
	if [[ "$after" != *"$osc8end"* ]]; then
		echo "OSC8 link should extend over the note (closing OSC8 must follow the note)" >&2
		return 1
	fi
}

