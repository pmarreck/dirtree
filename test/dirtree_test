fi

export PATH="$PB_BIN_ROOT:$PATH"
: "${TMPDIR:=/tmp}"   # default TMPDIR to /tmp if unset/empty
TMPDIR="${TMPDIR%/}"  # drop any trailing slash
export TMPDIR

is_compiled_binary() {
	file "$DIRTREE_BIN" 2>/dev/null | grep -qE 'Mach-O|ELF|PE32'
}

declare -a TEST_TEMP_PATHS=()

cleanup() {
	for path in "${TEST_TEMP_PATHS[@]}"; do
		if [[ -n "$path" && -e "$path" ]]; then
			rm -rf "$path"
		fi
	done
}
trap cleanup EXIT

canonical_tmpdir() {
	local base="${TMPDIR:-/tmp}"
	base="${base%/}"
	cd "$base" && pwd -P
}

export TEST_TMPDIR=${TEST_TMPDIR:-$(canonical_tmpdir)}

export PRINTABLE_BINARY_MUTE_STATS=${PRINTABLE_BINARY_MUTE_STATS:-true}

# shellcheck disable=SC1091
source "$TEST_SCRIPT_DIR/capture.bash"

PRINTABLE_CACHE_FILE=${PRINTABLE_CACHE_FILE:-"$TEST_TMPDIR/printable-cache"}
declare -A PRINTABLE_CACHE=()
PRINTABLE_CACHE_LOADED=false

new_tmpdir() {
	local dir
	dir=$(mktemp -d "${TEST_TMPDIR}/dirtree-test.XXXXXXXX") || return 1
	TEST_TEMP_PATHS+=("$dir")
