set -uo pipefail

DIRTREE_ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
DIRTREE_BIN="$DIRTREE_ROOT/dirtree"

if [[ ! -x "$DIRTREE_BIN" ]]; then
	echo "dirtree binary not found at $DIRTREE_BIN" >&2
	exit 1
fi

PRINTABLE_BINARY_BIN=${PRINTABLE_BINARY_BIN:-$(command -v printable_binary || true)}
if [[ -z "$PRINTABLE_BINARY_BIN" ]]; then
	echo "printable_binary not found in PATH" >&2
	exit 1
fi

BASH_BIN=${BASH_BIN:-$(command -v bash || true)}
if [[ -z "$BASH_BIN" ]]; then
	echo "bash binary not found" >&2
	exit 1
fi

export PATH="$DIRTREE_ROOT:$PATH"
export TMPDIR="${TMPDIR:-/tmp}"

declare -a TEST_TEMP_PATHS=()

cleanup() {
	for path in "${TEST_TEMP_PATHS[@]}"; do
		if [[ -n "$path" && -e "$path" ]]; then
			rm -rf "$path"
		fi
	done
}
trap cleanup EXIT

new_tmpdir() {
	local dir
	dir=$(mktemp -d "${TMPDIR%/}/dirtree-test.XXXXXXXX") || return 1
	TEST_TEMP_PATHS+=("$dir")
	printf '%s\n' "$dir"
}

new_tmpfile() {
	local file
	file=$(mktemp "${TMPDIR%/}/dirtree-test.XXXXXXXX") || return 1
	TEST_TEMP_PATHS+=("$file")
	printf '%s\n' "$file"
}

init_git_repo() {
	local dir="$1"
	(
		cd "$dir" && \
		git init -q >/dev/null && \
		git config user.name "dirtree-test" && \
		git config user.email "dirtree@example.com"
	)
}

create_tool_dir_without_eza() {
	local tool_dir fake_root fake_bin
	tool_dir=$(dirname "$BASH_BIN")
	fake_root=$(mktemp -d "${TMPDIR%/}/dirtree-no-eza.XXXXXXXX") || return 1
	TEST_TEMP_PATHS+=("$fake_root")
	fake_bin="$fake_root/bin"
	mkdir -p "$fake_bin"
	while IFS= read -r path; do
		local name
		name=$(basename "$path")
		[[ "$name" == "eza" ]] && continue
		ln -s "$path" "$fake_bin/$name"
	done < <(find "$tool_dir" -maxdepth 1 -mindepth 1 ! -type d -print)
	printf '%s\n' "$fake_bin"
}

run_and_capture() {
	local stdout_file="$1"
	local stderr_file="$2"
	shift 2
	"$@" >"$stdout_file" 2>"$stderr_file"
	return $?
}

run_quiet() {
	"$@" >/dev/null 2>&1
}

encode_printable() {
	local __var="$1"
	local input="$2"
	local encoded
	encoded=$(printf '%s' "$input" | "$PRINTABLE_BINARY_BIN" 2>/dev/null)
	printf -v "$__var" '%s' "$encoded"
}

encode_file_printable() {
	local __var="$1"
	local file="$2"
	local encoded
	encoded=$("$PRINTABLE_BINARY_BIN" 2>/dev/null <"$file")
	printf -v "$__var" '%s' "$encoded"
}

build_decorated_root_header_plain() {
	local __var="$1" target="$2" icons="${3:-true}" icon_char="${4:-}"
	local base parent
	base=$(basename "$target")
	parent=$(dirname "$target")
	if [[ "$icons" == true ]]; then
		printf -v "$__var" $'\e[34m%s \e[36m%s/\e[0m\e]8;;file://%s\e\\\e[1;34m%s\e[0m/\e]8;;\e\\\n' \
			"$icon_char" "$parent" "$target" "$base"
	else
		printf -v "$__var" $'\e[36m%s/\e[0m\e]8;;file://%s\e\\\e[1;34m%s\e[0m/\e]8;;\e\\\n' \
			"$parent" "$target" "$base"
	fi
}

build_decorated_with_hyperlinks_plain() {
	local __var="$1" target="$2" filename="$3" icons="${4:-true}"
	local prefix
	if [[ "$icons" == true ]]; then
		prefix=$'└──  '
	else
		prefix=$'└── '
	fi
	printf -v "$__var" $'%s\e]8;;file://%s/%s\e\\%s\e]8;;\e\\\n' \
		"$prefix" "$target" "$filename" "$filename"
}

build_decorated_without_hyperlinks_plain() {
	local __var="$1" target="$2" filename="$3"
	local base parent
	base=$(basename "$target")
	parent=$(dirname "$target")
	printf -v "$__var" $'\e[34m \e[36m%s/\e[0m\e[1;34m%s\e[0m/\n└──  %s\n' \
		"$parent" "$base" "$filename"
}

compare_printable() {
	local name="$1"
	local actual="$2"
	local expected="$3"
	if [[ "$actual" == "$expected" ]]; then
		return 0
	fi
	echo "  Expected ($name):" >&2
	echo "${expected}" >&2
	echo "  Actual:" >&2
	echo "${actual}" >&2
	return 1
}

test_count=0
fail_count=0

run_test() {
	local name="$1"
	shift
	((test_count++))
	if "$@"; then
		echo "✓ $name"
	else
		echo "✗ $name" >&2
		((fail_count++))
	fi
}

# Test implementations

test_basic_listing_prints_absolute_root_header() {
	local workspace
	workspace=$(new_tmpdir)
	local target="$workspace/basic-root"
	mkdir -p "$target"
	local stdout_file stderr_file
	stdout_file=$(new_tmpfile)
	stderr_file=$(new_tmpfile)
	if ! run_and_capture "$stdout_file" "$stderr_file" "$DIRTREE_BIN" "$target"; then
		echo "dirtree exited non-zero for $target" >&2
		return 1
	fi
	if [[ -s "$stderr_file" ]]; then
		echo "Unexpected stderr for basic listing" >&2
		cat "$stderr_file" >&2
		return 1
	fi
	local actual_pb expected_plain expected_pb
	encode_file_printable actual_pb "$stdout_file"
	printf -v expected_plain ' %s/\n' "$target"
	encode_printable expected_pb "$expected_plain"
	compare_printable "basic listing prints absolute root header" "$actual_pb" "$expected_pb"
}

