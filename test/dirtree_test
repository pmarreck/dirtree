	# Check for single-quoted display name
	if [[ "$actual_plain" != *"'sys (server)'"* ]]; then
		echo "Missing quoted display name \"'sys (server)'\" in output" >&2
		echo "Actual:" >&2
		echo "$actual_plain" >&2
		return 1
	fi
	# Check for closed-with-children marker
	if [[ "$actual_plain" != *"/*"* ]]; then
		echo "Missing closed marker '/*' in output" >&2
		echo "Actual:" >&2
		echo "$actual_plain" >&2
		return 1
	fi
	# Check for OSC8 hyperlink start sequence
	if [[ "$actual_plain" != *$'\e]8;;file://'* ]]; then
		echo "Missing OSC8 hyperlink start in output" >&2
		echo "Actual:" >&2
		echo "$actual_plain" >&2
		return 1
	fi
}

