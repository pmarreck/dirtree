test_eza_availability() {
	# Zig binary doesn't use eza - skip this test for compiled binaries
	if is_compiled_binary; then
		return 0
	fi
	local workspace
	workspace=$(new_tmpdir)
	local target="$workspace/eza-check"
	mkdir -p "$target"
	local fake_path
	fake_path=$(new_tmpdir)
	cat >"$fake_path/eza" <<'EOF'
#!/usr/bin/env bash
exit 0
EOF
	chmod +x "$fake_path/eza"
	local original_path="$PATH"
	local cnf_env path_log
	cnf_env=$(new_tmpfile)
	path_log=$(new_tmpfile)
cat >"$cnf_env" <<'EOF'
command_not_found_handle() {
	return 127
}
command() {
	if [[ "$1" == "-v" && "$2" == "eza" ]]; then
		return 1
	fi
	builtin command "$@"
}
echo "$PATH" >"$DIRTREE_PATH_LOG"
EOF
	local stdout_pb="" stderr_pb="" rc=0
	if ! capture_command_printable stdout_pb stderr_pb rc \
		env PATH="$fake_path:$original_path" \
		DIRTREE_PATH_LOG="$path_log" \
		BASH_ENV="$cnf_env" \
		"$DIRTREE_BIN" "$target"; then
		echo "capture_command_printable failed for eza availability" >&2
		return 1
	fi
	if [[ "$rc" -eq 0 ]]; then
		echo "Expected eza availability failure" >&2
		return 1
	fi
	local recorded_path
	recorded_path=$(<"$path_log")
	if [[ "$recorded_path" != "$fake_path:$original_path" ]]; then
		echo "PATH inside dirtree did not match expected value" >&2
		return 1
	fi
	if [[ -n "$stdout_pb" ]]; then
		echo "Expected empty stdout for eza failure" >&2
		return 1
	fi
	local expected_plain expected_pb
	expected_plain=$'Error: eza is not installed. Please install eza first.\n'
	encode_printable expected_pb "$expected_plain"
	compare_printable "eza availability" "$stderr_pb" "$expected_pb"
}

