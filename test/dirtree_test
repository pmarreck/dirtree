test_compare_printable_short_circuits_equal_encoded() {
	local real_pb helper_dir marker helper encoded
	real_pb="$PRINTABLE_BINARY_BIN"
	helper_dir=$(new_tmpdir)
	marker="$helper_dir/marker"
	helper="$helper_dir/pb_stub"
	cat >"$helper" <<'EOS'
#!/usr/bin/env bash
set -u
if [[ -e "$MARKER_PATH" ]]; then
	printf 'second\n'
else
	echo hit >"$MARKER_PATH"
	printf 'first\n'
fi
EOS
	chmod +x "$helper"
	encoded=$(printf 'short-circuit' | "$real_pb")
	local saved_pb="$PRINTABLE_BINARY_BIN"
	local saved_marker_path="${MARKER_PATH:-}"
	PRINTABLE_BINARY_BIN="$helper"
	MARKER_PATH="$marker"
	export MARKER_PATH
	if ! compare_printable "short circuit equal" "$encoded" "$encoded"; then
		PRINTABLE_BINARY_BIN="$saved_pb"
		MARKER_PATH="$saved_marker_path"
		if [[ -n "$saved_marker_path" ]]; then :; fi
		return 1
	fi
	PRINTABLE_BINARY_BIN="$saved_pb"
	MARKER_PATH="$saved_marker_path"
	if [[ -e "$marker" ]]; then
		echo "compare_printable invoked printable_binary despite equal encoded inputs" >&2
		return 1
	fi
}

