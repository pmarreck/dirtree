test_head_truncates_output() {
	local workspace target stdout_pb="" stderr_pb="" rc=0
	workspace=$(new_tmpdir)
	target="$workspace/head-trunc"
	mkdir -p "$target/aaa" "$target/bbb" "$target/ccc" "$target/ddd"
	touch "$target/file1.txt" "$target/file2.txt" "$target/file3.txt"
	# With --head 3, we get root header + 2 entries = 3 lines
	if ! capture_dirtree_printable stdout_pb stderr_pb rc --simple --head 3 "$target"; then
		echo "capture helper failed for --head" >&2
		return 1
	fi
	if [[ "$rc" -ne 0 ]]; then
		echo "--head run failed with rc=$rc" >&2
		return 1
	fi
	# Count lines in stdout (grep -c '' counts lines including the last without trailing newline)
	local plain=""
	decode_printable plain "$stdout_pb"
	local line_count
	line_count=$(printf '%s\n' "$plain" | grep -c '')
	if [[ "$line_count" -ne 3 ]]; then
		echo "Expected 3 lines but got $line_count" >&2
		printf '%s' "$plain" >&2
		return 1
	fi
	# Stderr should contain truncation message
	if [[ -z "$stderr_pb" ]]; then
		echo "Expected stderr with truncation notice" >&2
		return 1
	fi
	local stderr_plain=""
	decode_printable stderr_plain "$stderr_pb"
	if [[ "$stderr_plain" != *"truncated after 3 lines"* ]]; then
		echo "Expected truncation message in stderr" >&2
		echo "Got: $stderr_plain" >&2
		return 1
	fi
}

